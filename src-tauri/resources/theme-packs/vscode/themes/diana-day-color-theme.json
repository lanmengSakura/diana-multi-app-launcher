  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8D7B83", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#A94C6E" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#A45B66" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#B84970" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#936C23" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#70558C" }
    },
    {
      "scope": ["variable", "meta.definition.variable.name", "support.variable"],
      "settings": { "foreground": "#332B2F" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#8E5367" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#B84970" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#936C23" }
    },
    {
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#7E4B60" }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": { "foreground": "#B84970", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#2C2529", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#8E5367", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inserted", "markup.changed"],
      "settings": { "foreground": "#557D51" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#B53F52" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FFFFFF", "background": "#B53F52" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#70558C",
    "class": "#70558C",
    "type": "#70558C",
    "interface": "#536B91",
    "enum": "#70558C",
    "function": "#936C23",
    "method": "#936C23",
    "parameter": "#8E5367",
    "property": "#332B2F",
    "variable.readonly": "#A45B66",
    "keyword": "#B84970",
    "string": "#A94C6E",
    "number": "#A45B66",
    "comment": { "foreground": "#8D7B83", "italic": true }
  }
}
