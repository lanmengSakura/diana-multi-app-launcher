  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7D7379", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#E0A2B6" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#C9959D" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#E884A6" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#EBCB86" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#C5ACDD" }
    },
    {
      "scope": ["variable", "meta.definition.variable.name", "support.variable"],
      "settings": { "foreground": "#E7DDE2" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#D8B0BD" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#E884A6" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#D5B26E" }
    },
    {
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#B99BA6" }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": { "foreground": "#E884A6", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#F3EEF0", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#D8B0BD", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inserted", "markup.changed"],
      "settings": { "foreground": "#A8D19F" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#F08A96" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FFFFFF", "background": "#A43E55" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#C5ACDD",
    "class": "#C5ACDD",
    "type": "#C5ACDD",
    "interface": "#B7B6E2",
    "enum": "#C5ACDD",
    "function": "#EBCB86",
    "method": "#EBCB86",
    "parameter": "#D8B0BD",
    "property": "#E7DDE2",
    "variable.readonly": "#C9959D",
    "keyword": "#E884A6",
    "string": "#E0A2B6",
    "number": "#C9959D",
    "comment": { "foreground": "#7D7379", "italic": true }
  }
}
